      "id": "node-sys03-parse-attributes",
      "name": "Parse [[Attributes]] & Prepare Compose.xlsx Data",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        480,
        360
      ],
      "parameters": {
        "jsCode": "// PORTFOLIO_SYS03_COMPOSE_BATCH: Parses [[First Name]], [[Middle Name]], [[Last Name]], [[Company Name]], [[Email Address]], [[Contact Number]]\nconst root = $json.body || $json || {};\nconst data = (root.data && typeof root.data === 'object' && !root.actionMode) ? root.data : root;\nconst actionMode = String(data.actionMode || data.mode || data.action || '').trim();\nconst msgStr = (typeof data.message === 'string') ? data.message : '';\nconst rawTemplate = String(data.composedMessageRaw || data.composed_message || data.template_message || msgStr || '').trim();\nconst rawSubject = String(data.subjectTemplate || data.subject || 'Custom Outreach for [[Company Name]]').trim();\nconst fullName = String(data.name || data.full_name || '').trim();\nconst parts = fullName.split(/\\s+/).filter(Boolean);\nconst firstName = String(data.firstName || data.first_name || (parts[0] || '')).trim();\nconst middleName = String(data.middleName || data.middle_name || (parts.length >= 3 ? parts[1] : '')).trim();\nconst lastName = String(data.lastName || data.last_name || (parts.length >= 3 ? parts.slice(2).join(' ') : (parts[1] || ''))).trim();\nconst companyName = String(data.companyName || data.company_name || data.company || '').trim();\nconst emailAddress = String(data.emailAddress || data.email_address || data.email || data.to || '').trim();\nconst contactNumber = String(data.contactNumber || data.contact_number || data.phone || '').trim();\nconst replaceAttributes = (txt) => {\n  if (!txt) return '';\n  const map = {\n    'first name': firstName,\n    'firstname': firstName,\n    'first_name': firstName,\n    'middle name': middleName,\n    'middlename': middleName,\n    'middle_name': middleName,\n    'last name': lastName,\n    'lastname': lastName,\n    'last_name': lastName,\n    'company name': companyName,\n    'companyname': companyName,\n    'company_name': companyName,\n    'company': companyName,\n    'email address': emailAddress,\n    'emailaddress': emailAddress,\n    'email_address': emailAddress,\n    'email': emailAddress,\n    'contact number': contactNumber,\n    'contactnumber': contactNumber,\n    'contact_number': contactNumber,\n    'phone': contactNumber\n  };\n  return String(txt)\n    .replace(/\\[\\[\\s*([^\\[\\]]+?)\\s*\\]\\]/g, (m, key) => {\n      const k = String(key || '').trim().toLowerCase().replace(/\\s+/g, ' ');\n      return Object.prototype.hasOwnProperty.call(map, k) ? map[k] : m;\n    })\n    .replace(/[ \\t]{2,}/g, ' ')\n    .trim();\n};\nconst personalizedMessage = replaceAttributes(rawTemplate) || String(data.personalizedMessage || data.body || '').trim();\nconst personalizedSubject = replaceAttributes(rawSubject) || String(data.personalizedSubject || 'Custom Outreach Message').trim();\nconst batchRowKey = String(data.batchRowKey || data.batch_row_key || (emailAddress ? `portfolio_row_${emailAddress}` : '')).trim();\nconst emailAccountId = String(data.emailAccountId || data.account_id || 'email_gmail_ca_58qp11H0JD4J').trim();\nreturn [{\n  json: {\n    actionMode,\n    composedMessageRaw: rawTemplate,\n    firstName,\n    middleName,\n    lastName,\n    companyName,\n    emailAddress,\n    contactNumber,\n    personalizedSubject,\n    personalizedMessage,\n    batchRowKey,\n    emailAccountId\n  }\n}];"
      }
